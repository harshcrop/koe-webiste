# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://koe.example.com

# App release shown on the page
NEXT_PUBLIC_APP_VERSION=0.1.0

# Optional: host the .dmg elsewhere (e.g. GitHub Releases). Defaults to /downloads/Koe-0.1.0-universal.dmg in public/.
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_DOWNLOAD_CHECKSUM_URL=

# Optional footer links (hidden when empty)
NEXT_PUBLIC_RELEASE_NOTES_URL=
NEXT_PUBLIC_CONTACT_URL=
